<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rutas Barralaga - Demostración Operativa Zmax 200</title>
    <link href="https://api.mapbox.com/mapbox-gl-js/v2.14.1/mapbox-gl.css" rel="stylesheet">
    <style>
        body { margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; background: #f4f4f9; display: flex; height: 100vh; overflow: hidden; }
        
        /* Panel izquierdo: Lista de control de clientes */
        .panel-control {
            width: 400px; height: 100vh; background: #fff; box-shadow: 4px 0 15px rgba(0,0,0,0.1);
            display: flex; flex-direction: column; z-index: 10;
        }
        .header-panel { padding: 20px; background: #111; color: #fff; }
        .header-panel h2 { margin: 0; font-size: 20px; }
        .header-panel p { margin: 5px 0 0 0; font-size: 13px; color: #aaa; }
        
        .lista-pedidos { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px; }
        
        .tarjeta-pedido {
            border: 1px solid #e5e7eb; border-radius: 10px; padding: 14px; background: #fafafa;
            display: flex; flex-direction: column; gap: 8px; transition: all 0.2s;
        }
        .tarjeta-pedido:hover { border-color: #111; box-shadow: 0 2px 8px rgba(0,0,0,0.05); }
        .tarjeta-pedido.completado { background: #f0fdf4; border-color: #86efac; opacity: 0.7; }
        
        .info-superior { display: flex; justify-content: space-between; align-items: flex-start; }
        .badge-numero { background: #111; color: #fff; font-weight: bold; padding: 3px 8px; border-radius: 6px; font-size: 12px; }
        .tarjeta-pedido.completado .badge-numero { background: #16a34a; }
        
        .cliente-nombre { font-weight: bold; font-size: 15px; color: #111; margin: 0; }
        .cliente-dir { font-size: 13px; color: #555; margin: 3px 0 0 0; }
        
        .botones-accion { display: flex; gap: 6px; margin-top: 5px; }
        .btn { flex: 1; padding: 8px; border: none; border-radius: 6px; font-size: 12px; font-weight: bold; cursor: pointer; text-align: center; }
        .btn-wa { background: #25D366; color: #fff; }
        .btn-ok { background: #16a34a; color: #fff; }
        .btn-map { background: #e5e7eb; color: #111; }

        /* Panel derecho: El Mapa */
        #map { flex: 1; height: 100vh; }

        /* Responsive para celulares */
        @media (max-width: 768px) {
            body { flex-direction: column; overflow: auto; }
            .panel-control { width: 100vw; height: 50vh; }
            #map { width: 100vw; height: 50vh; }
        }
    </style>
</head>
<body>

    <!-- Panel de Control y Lista de Clientes -->
    <div class="panel-control">
        <div class="header-panel">
            <h2>🚚 Rutas Barralaga</h2>
            <p>Control de Última Milla - Zmax 200</p>
        </div>
        <div class="lista-pedidos" id="contenedor-lista">
            <!-- Los pedidos se cargan dinámicamente aquí -->
        </div>
    </div>

    <!-- Mapa Maestro con Mapbox -->
    <div id="map"></div>

    <script src="https://api.mapbox.com/mapbox-gl-js/v2.14.1/mapbox-gl.js"></script>
    <script>
        // Token de Mapbox configurado
        mapboxgl.accessToken = 'pk.eyJ1Ijoiam9oYW5qYmFycmFsYWdhLXNvdXJjZSIsImEiOiJjbXc1MzZydDYwM3UwMnlvcDMwOXMyMWxrIn0.gWzeC9I8V_c6uRxnRIMIrg';

        // Coordenadas base en San Pedro Sula
        const BASE_SPS = [-88.0250, 15.5042];

        // Simulación de los 5 clientes que te mandaron pedido en orden riguroso
        let pedidos = [
            { id: 1, cliente: "Carlos Matute", direccion: "Colonia Trejo, 12 Calle", coords: [-88.0310, 15.5120], estado: "pendiente" },
            { id: 2, cliente: "María Echeverría", direccion: "Barrio Guamilito, 7 Ave", coords: [-88.0210, 15.5080], estado: "pendiente" },
            { id: 3, cliente: "Inversiones del Norte", direccion: "Zona Industrial El Periodista", coords: [-88.0120, 15.4950], estado: "pendiente" },
            { id: 4, cliente: "Ana Pineda", direccion: "Colonia Bográn", coords: [-88.0400, 15.5200], estado: "pendiente" },
            { id: 5, cliente: "Ferretería El Ahorro", direccion: "Segundo Anillo Periférico", coords: [-88.0050, 15.5150], estado: "pendiente" }
        ];

        let marcadores = [];

        // Inicializar el Mapa
        const map = new mapboxgl.Map({
            container: 'map',
            style: 'mapbox://styles/mapbox/streets-v12',
            center: BASE_SPS,
            zoom: 13
        });
        map.addControl(new mapboxgl.NavigationControl(), 'bottom-right');

        function renderizarSistema() {
            // 1. Limpiar marcadores anteriores del mapa
            marcadores.forEach(m => m.remove());
            marcadores = [];

            // Marcar la Base de Salida
            const elBase = document.createElement('div');
            elBase.innerHTML = '🏢';
            elBase.style.fontSize = '26px';
            marcadores.push(new mapboxgl.Marker(elBase).setLngLat(BASE_SPS).setPopup(new mapboxgl.Popup().setText('Base Rutas Barralaga')).addTo(map));

            // 2. Renderizar la lista en orden estricto (Del 1 al 5)
            const contenedor = document.getElementById('contenedor-lista');
            contenedor.innerHTML = '';

            pedidos.forEach((item, index) => {
                // Agregar pin numerado al mapa de Mapbox
                const colorPin = item.estado === 'completado' ? '#16a34a' : '#111111';
                const elPin = document.createElement('div');
                elPin.innerHTML = `<div style="background:${colorPin}; color:white; border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; font-weight:bold; font-size:12px; border:2px solid white; box-shadow:0 2px 6px rgba(0,0,0,0.3);">${index + 1}</div>`;
                
                const marker = new mapboxgl.Marker(elPin)
                    .setLngLat(item.coords)
                    .setPopup(new mapboxgl.Popup().setHTML(`<b>#${index + 1} - ${item.cliente}</b><br>${item.direccion}`))
                    .addTo(map);
                marcadores.push(marker);

                // Crear tarjeta visual en el panel izquierdo
                const card = document.createElement('div');
                card.className = `tarjeta-pedido ${item.estado === 'completado' ? 'completado' : ''}`;
                card.innerHTML = `
                    <div class="info-superior">
                        <div>
                            <span class="badge-numero">Parada #${index + 1}</span>
                            <p class="cliente-nombre">${item.cliente} ${item.estado === 'completado' ? '✅' : ''}</p>
                            <p class="cliente-dir">📍 ${item.direccion}</p>
                        </div>
                    </div>
                    <div class="botones-accion">
                        <button class="btn btn-map" onclick="enfocarMapa(${item.coords[0]}, ${item.coords[1]})">🗺️ Ver</button>
                        <button class="btn btn-wa" onclick="enviarWhatsApp('${item.cliente}', '${item.direccion}')">💬 WhatsApp</button>
                        ${item.estado === 'pendiente' ? `<button class="btn btn-ok" onclick="marcarEntregado(${item.id})">✔️ Entregado</button>` : ''}
                    </div>
                `;
                contenedor.appendChild(card);
            });
        }

        function enfocarMapa(lng, lat) {
            map.flyTo({ center: [lng, lat], zoom: 16 });
        }

        function marcarEntregado(id) {
            const pedido = pedidos.find(p => p.id === id);
            if(pedido) {
                pedido.estado = 'completado';
                renderizarSistema();
            }
        }

        function enviarWhatsApp(cliente, direccion) {
            const mensaje = encodeURIComponent(`Hola ${cliente}, le saludamos de Rutas Barralaga 🚚. Su pedido hacia *${direccion* `}* va en ruta.`);
            window.open(`https://wa.me/?text=${mensaje}`, '_blank');
        }

        // Cargar al iniciar
        map.on('load', () => {
            renderizarSistema();
        });
    </script>
</body>
</html>
